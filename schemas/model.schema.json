{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kopruq.local/schemas/model/1",
  "title": "KOPRUQ-SOLVER model, format version 1",
  "description": "Canonical units: m, kN, rad. Read by kopruq::io::readModel (include/kopruq/io/ModelJson.hpp), which also checks references, duplicates and geometry.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "kopruq-model"
    },
    "schema_version": {
      "const": 1
    },
    "units": {
      "$ref": "#/$defs/units"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "beams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/beam"
      }
    },
    "trusses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/truss"
      },
      "description": "Pin-ended axial-only members; read as beams with every rotational DOF released (see Truss3D.hpp)."
    },
    "springs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spring"
      },
      "description": "Discrete two-node spring/link elements (bearings, isolators, soil springs); see SpringLink.hpp."
    },
    "rigid_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rigid_link"
      },
      "description": "Master-slave multi-point constraints; a slave's 6 DOFs follow its master's rigidly. See kopruq/assembly/RigidLink.hpp. Supported by the static solver only."
    },
    "supports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/support"
      }
    },
    "load_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/load_case"
      }
    },
    "combinations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/combination"
      }
    },
    "response_spectra": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/response_spectrum_case"
      }
    }
  },
  "required": [
    "schema",
    "schema_version",
    "nodes",
    "materials",
    "sections",
    "beams",
    "supports"
  ],
  "additionalProperties": false,
  "$defs": {
    "units": {
      "type": "object",
      "properties": {
        "length": {
          "const": "m"
        },
        "force": {
          "const": "kN"
        },
        "angle": {
          "const": "rad"
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "Optional declaration; only canonical units are accepted."
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "elastic_modulus": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "kN/m^2"
        },
        "poisson_ratio": {
          "type": "number",
          "exclusiveMinimum": -1,
          "exclusiveMaximum": 0.5
        },
        "unit_weight": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "kN/m^3, used by self-weight"
        }
      },
      "required": [
        "id",
        "elastic_modulus",
        "poisson_ratio"
      ],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "area": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "Iy": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "Iz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "J": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "Asy": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Effective shear area, y-bending plane [m^2]; 0 = rigid in shear (Euler-Bernoulli)"
        },
        "Asz": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Effective shear area, z-bending plane [m^2]; 0 = rigid in shear (Euler-Bernoulli)"
        }
      },
      "required": [
        "id",
        "area",
        "Iy",
        "Iz",
        "J"
      ],
      "additionalProperties": false
    },
    "beam": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "material": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "integer",
          "minimum": 1
        },
        "reference_y": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            0,
            1,
            0
          ],
          "description": "Defines local y: its component normal to the member axis"
        },
        "releases": {
          "$ref": "#/$defs/releases"
        },
        "offset1": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [0, 0, 0],
          "description": "Rigid end offset at node1, global axes: vector from node1 to the member's actual end point"
        },
        "offset2": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [0, 0, 0],
          "description": "Rigid end offset at node2, global axes: vector from node2 to the member's actual end point"
        }
      },
      "required": [
        "id",
        "nodes",
        "material",
        "section"
      ],
      "additionalProperties": false
    },
    "truss": {
      "type": "object",
      "description": "Pin-ended 3D truss member: axial stiffness only, no bending/shear/torsion. reference_y and releases are not accepted since orientation does not affect a truss's stiffness.",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "material": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "nodes",
        "material",
        "section"
      ],
      "additionalProperties": false
    },
    "spring": {
      "type": "object",
      "description": "Two-node discrete spring/link: six independent linear springs, one per local DOF (UX,UY,UZ,RX,RY,RZ). node1/node2 may coincide (zero-length link); orientation is given directly via local_x/reference_y rather than derived from the nodes.",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "local_x": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [1, 0, 0],
          "description": "Spring local x direction, global axes"
        },
        "reference_y": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [0, 1, 0],
          "description": "Defines local y: its component normal to local_x"
        },
        "stiffness": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 6,
          "maxItems": 6,
          "description": "kx,ky,kz [kN/m], krx,kry,krz [kNm/rad], local axes"
        }
      },
      "required": [
        "id",
        "nodes",
        "stiffness"
      ],
      "additionalProperties": false
    },
    "rigid_link": {
      "type": "object",
      "description": "A slave node's 6 DOFs are entirely determined by its master's via rigid-body kinematics; the slave cannot carry its own restraints.",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "master": {
          "type": "integer",
          "minimum": 1
        },
        "slave": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "master",
        "slave"
      ],
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "properties": {
        "node": {
          "type": "integer",
          "minimum": 1
        },
        "restraints": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "minItems": 6,
          "maxItems": 6,
          "description": "UX, UY, UZ, RX, RY, RZ"
        }
      },
      "required": [
        "node",
        "restraints"
      ],
      "additionalProperties": false
    },
    "load_case": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "self_weight": {
          "type": "number",
          "default": 0,
          "description": "Factor on unit_weight*area per true length, global -Z"
        },
        "nodal": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nodal_load"
          }
        },
        "member": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member_load"
          }
        },
        "point": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point_load"
          }
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "nodal_load": {
      "type": "object",
      "properties": {
        "node": {
          "type": "integer",
          "minimum": 1
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6,
          "description": "FX, FY, FZ [kN], MX, MY, MZ [kNm], global axes"
        }
      },
      "required": [
        "node",
        "values"
      ],
      "additionalProperties": false
    },
    "member_load": {
      "type": "object",
      "properties": {
        "element": {
          "type": "integer",
          "minimum": 1
        },
        "axes": {
          "enum": [
            "local",
            "global"
          ]
        },
        "direction": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "w1": {
          "type": "number",
          "description": "kN/m at start"
        },
        "w2": {
          "type": "number",
          "description": "kN/m at end; defaults to w1"
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "end": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "projected": {
          "type": "boolean",
          "default": false,
          "description": "Global loads only: per length projected on the plane normal to the load direction"
        },
        "kind": {
          "enum": [
            "force",
            "moment"
          ],
          "default": "force",
          "description": "moment: distributed moment about `direction` [kNm/m]; projected is not allowed"
        }
      },
      "required": [
        "element",
        "axes",
        "direction",
        "w1"
      ],
      "additionalProperties": false
    },
    "combination": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/combination_term"
          },
          "minItems": 1
        }
      },
      "required": [
        "name",
        "terms"
      ],
      "additionalProperties": false
    },
    "combination_term": {
      "type": "object",
      "properties": {
        "case": {
          "type": "string",
          "description": "Load case name"
        },
        "factor": {
          "type": "number"
        }
      },
      "required": [
        "case",
        "factor"
      ],
      "additionalProperties": false
    },
    "point_load": {
      "type": "object",
      "description": "Concentrated force [kN] or moment [kNm] on a member",
      "properties": {
        "element": {
          "type": "integer",
          "minimum": 1
        },
        "axes": {
          "enum": [
            "local",
            "global"
          ]
        },
        "direction": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "value": {
          "type": "number"
        },
        "position": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of member length from the first node"
        },
        "kind": {
          "enum": [
            "force",
            "moment"
          ],
          "default": "force"
        }
      },
      "required": [
        "element",
        "axes",
        "direction",
        "value",
        "position"
      ],
      "additionalProperties": false
    },
    "releases": {
      "type": "object",
      "description": "End releases in member-local DOF order UX, UY, UZ, RX, RY, RZ; true = released (no end force). Combinations that leave the element unstable are rejected.",
      "properties": {
        "start": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "minItems": 6,
          "maxItems": 6,
          "default": [
            false,
            false,
            false,
            false,
            false,
            false
          ]
        },
        "end": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "minItems": 6,
          "maxItems": 6,
          "default": [
            false,
            false,
            false,
            false,
            false,
            false
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "response_spectrum_case": {
      "type": "object",
      "description": "A named modal/response-spectrum analysis request; the spectrum shape itself is caller-supplied, not computed by the solver.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "num_modes": {
          "type": "integer",
          "minimum": 1,
          "default": 6
        },
        "spectrum": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/spectrum_point"
          }
        }
      },
      "required": [
        "name",
        "direction",
        "spectrum"
      ],
      "additionalProperties": false
    },
    "spectrum_point": {
      "type": "object",
      "properties": {
        "period": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "seconds"
        },
        "sa": {
          "type": "number",
          "minimum": 0,
          "description": "spectral acceleration, m/s^2"
        }
      },
      "required": [
        "period",
        "sa"
      ],
      "additionalProperties": false
    }
  }
}
