/* KOPRUQ-SOLVER -- MIDAS Verification Tool, V2.0 dark theme.
   Palette per the approved V2.0 revision spec:
   Window #0B1220, Panel #131F31, Panel Border #29384E, Table #0D1523,
   Primary Blue #2563EB, Primary Hover #3B82F6, Text Primary #E5EAF2,
   Text Secondary #A6B2C3, Success #22C55E, Warning #F59E0B, Error #EF4444,
   Disabled Background #1C293C. V2.1: the checkbox checkmark is now
   :/icons/check.svg, compiled into the binary via icons.qrc (Qt's QSS
   url() can address Qt resource paths directly), replacing the older
   {CHECK_ICON}-placeholder substitution of an on-disk check.png. */

* {
  font-family: "Segoe UI", "Noto Sans", sans-serif;
  font-size: 12px;
  color: #E5EAF2;
}

QMainWindow, QWidget {
  background-color: #0B1220;
}

QGroupBox {
  background-color: #131F31;
  border: 1px solid #29384E;
  border-radius: 6px;
  margin-top: 14px;
  padding: 8px;
  font-weight: 600;
  font-size: 14px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 4px;
  color: #A6B2C3;
}

#stepSidebar {
  background-color: #131F31;
  border-right: 1px solid #29384E;
}

QLineEdit, QPlainTextEdit, QTextEdit, QTableWidget, QTableView {
  background-color: #0D1523;
  border: 1px solid #29384E;
  border-radius: 4px;
  padding: 4px;
  selection-background-color: #2563EB;
  font-size: 13px;
}

QLineEdit:read-only {
  color: #A6B2C3;
}

QPushButton {
  background-color: #1C293C;
  border: 1px solid #29384E;
  border-radius: 6px;
  padding: 6px 14px;
  font-size: 13px;
}

QPushButton:hover:!disabled {
  background-color: #263150;
}

QPushButton:disabled {
  color: #5c6680;
}

QPushButton[primary="true"] {
  background-color: #2563EB;
  border: 1px solid #2563EB;
  color: #ffffff;
  font-weight: 600;
}

QPushButton[primary="true"]:hover:!disabled {
  background-color: #3B82F6;
}

/* V2.1: the sidebar's four step buttons are QToolButton (icon above text via
   Qt::ToolButtonTextUnderIcon), styled the same as QPushButton above since QSS
   selectors don't cascade across unrelated widget classes. */
QToolButton {
  background-color: #1C293C;
  border: 1px solid #29384E;
  border-radius: 6px;
  padding: 6px 14px;
  font-size: 13px;
}

QToolButton:hover:!disabled {
  background-color: #263150;
}

QToolButton:disabled {
  color: #5c6680;
}

QToolButton[primary="true"] {
  background-color: #2563EB;
  border: 1px solid #2563EB;
  color: #ffffff;
  font-weight: 600;
}

QToolButton[primary="true"]:hover:!disabled {
  background-color: #3B82F6;
}

#stepSidebar QToolButton {
  padding: 6px 12px;
  font-size: 13px;
}

QCheckBox {
  spacing: 6px;
}

QCheckBox::indicator {
  width: 17px;
  height: 17px;
  border-radius: 3px;
  border: 1px solid #A6B2C3;
  background-color: #0D1523;
}

QCheckBox::indicator:unchecked:hover {
  border: 1px solid #3B82F6;
}

QCheckBox::indicator:checked {
  background-color: #2563EB;
  border: 1px solid #2563EB;
  image: url(:/icons/check.svg);
}

QCheckBox::indicator:disabled {
  background-color: #1C293C;
  border: 1px solid #29384E;
}

QTabWidget::pane {
  border: 1px solid #29384E;
  border-radius: 6px;
  top: -1px;
}

QTabBar::tab {
  background-color: #131F31;
  border: 1px solid #29384E;
  border-bottom: none;
  padding: 6px 14px;
  margin-right: 2px;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
}

QTabBar::tab:selected {
  background-color: #2563EB;
  color: #ffffff;
}

QHeaderView::section {
  background-color: #1C293C;
  border: 1px solid #29384E;
  padding: 4px;
}

QProgressBar {
  background-color: #0D1523;
  border: 1px solid #29384E;
  border-radius: 4px;
  text-align: center;
}

QProgressBar::chunk {
  background-color: #2563EB;
  border-radius: 3px;
}

QSplitter::handle {
  background-color: #0B1220;
}

QLabel#statusBadge {
  border-radius: 3px;
  padding: 1px 6px;
}
