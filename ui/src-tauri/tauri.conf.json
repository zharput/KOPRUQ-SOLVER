{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KOPRUQ-SOLVER",
  "version": "0.1.0",
  "identifier": "com.kopruq.solver.ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "KOPRUQ-SOLVER", "width": 1600, "height": 900, "minWidth": 1100, "minHeight": 650 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
